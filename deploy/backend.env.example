# Copiar a ~/.config/rt-apk/backend.env y ajustar. La contraseña de RT NO va aquí (es un podman secret).

# --- Fase inicial: sin Keycloak y sin RT, con datos de ejemplo ---
SPRING_PROFILES_ACTIVE=demo

# --- Con Keycloak y RT reales: quitar la línea anterior y rellenar esto ---
#KEYCLOAK_ISSUER_URI=https://keycloak.example.org/realms/rt-apk
#KEYCLOAK_AUDIENCE=rt-api
#RT_API_VERSION=rest1
#RT_URL=https://rt.example.org/REST/1.0
#RT_USERNAME=svc-rt-apk
#RT_TIME_ZONE=Europe/Madrid
#APP_AGENT_ROLE=rt-agent
