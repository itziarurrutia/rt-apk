# Conexión al RT. Copiar a application-security.yml (en esta carpeta, backend/) y rellenar.
# application-security.yml NO se sube a git (.gitignore). Otra ubicación: variable RT_CONFIG_FILE.
# Las variables de entorno con el mismo nombre tienen prioridad sobre este fichero.
#
# Pon los valores entre comillas simples; si la contraseña lleva una comilla simple, escríbela doble ('').

# URL base del REST, incluido /REST/1.0 (mejor https: la contraseña viaja en la URL)
RT_URL: 'https://rtserver.example.org/REST/1.0'
RT_USERNAME: 'usuario'
RT_PASSWORD: 'contraseña'

# Servidor con certificado caducado (p. ej. https://rt5.unavarra.es/REST/1.0): huella SHA-256 del
# certificado que se acepta igualmente. Solo ese certificado exacto; el resto se valida normal.
#   openssl s_client -connect rt5.unavarra.es:443 </dev/null | openssl x509 -noout -fingerprint -sha256
#RT_TLS_PINNED_SHA256: 'B8:3E:9F:82:44:FD:54:90:8E:51:4D:2C:CC:4E:0B:11:5F:92:A7:11:16:04:9A:32:5B:CB:E9:EF:29:F2:51:CC'

# Vista de tickets: activos de la cola creados en las últimas N horas
#APP_TICKETS_HOURS: 5
#APP_TICKETS_QUEUE: apoyo.dpto

# Consulta de tickets según el rol de Keycloak del usuario (TicketSQL de RT). Con varios roles se
# unen con OR. Quien no tenga ninguno de estos roles ve la consulta por defecto (si tiene rt-agent).
# {usuario} y {email} se sustituyen por los del usuario que ha entrado en Keycloak (entre comillas).
#app:
#  tickets:
#    queries-by-role:
#      ptgas: "Queue = 'apoyo.admon' AND Created > '2 hours ago' AND Owner = '{usuario}' AND Status = '__Active__'"
#      ingenieria: "Created > '2 hours ago' AND Status = '__Active__' AND Queue = 'apoyo.dpto' AND CF.{NDepartamento} = 'Ingenieria'"
#    # Texto tras "Perfil <rol>" en la vista de tickets (por defecto "activos")
#    descriptions-by-role:
#      ptgas: "activos asignados a mí · creados en las últimas 2 horas"
#      ingenieria: "activos de Ingeniería · creados en las últimas 2 horas"

# Realm de Keycloak (emisor de los tokens)
#KEYCLOAK_ISSUER_URI: 'https://baobab2.unavarra.es:7443/realms/rtmobile'

# HTTPS directo en el puerto de la aplicación (contenedor de deploy/jar con el certificado del servidor en un .jks).
# En Keycloak, rt-web debe admitir https://<servidor>:<puerto>/* (en baobab2, 8443) como redirect URI.
#server:
#  ssl:
#    enabled: true
#    key-store: 'file:/app/baobab2.unavarra.es.jks'
#    key-store-type: JKS
#    key-store-password: 'contraseña-del-jks'
#    key-alias: 'alias-del-certificado'

#RT_API_VERSION: rest1
#RT_TIME_ZONE: Europe/Madrid

# Para probar contra el RT real sin Keycloak (solo en local):
#APP_SECURITY_ENABLED: false
