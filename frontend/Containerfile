# Imagen del frontend: compila Angular y lo sirve con nginx, que además hace de proxy de /api al
# backend (127.0.0.1:8085 dentro del pod). Construir desde la carpeta frontend/:
#   podman build -t rt-apk-web:latest .

FROM docker.io/library/node:22-alpine AS build
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npx ng build

FROM docker.io/library/nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist/frontend/browser /usr/share/nginx/html
EXPOSE 80
